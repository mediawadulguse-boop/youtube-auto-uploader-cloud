PORT=3000
APP_URL=https://your-app.example.com
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
DATA_DIR=/data
WORKER_INTERVAL_MS=5000
YOUTUBE_CHUNK_MB=8

# Opsional untuk development; wajib pada deployment PostgreSQL. Jangan commit URL asli.
DATABASE_URL=

# Provider utama; semua key hanya disimpan di server/Railway.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-20b
AI_AUTO_FALLBACK=true
AI_FALLBACK_ORDER=openai,groq,gemini
AI_DAILY_LIMIT=50

# Diagnosis operator opt-in satu kali; biarkan kosong pada operasi normal.
AI_SMOKE_ONCE=
AI_SMOKE_PROVIDERS=
