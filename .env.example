PORT=3000
APP_URL=https://your-app.example.com
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
DATA_DIR=/data
WORKER_INTERVAL_MS=5000
YOUTUBE_CHUNK_MB=8

# Opsional untuk development; wajib pada deployment PostgreSQL. Jangan commit URL asli.
DATABASE_URL=

# Provider utama; semua key hanya disimpan di server/Railway.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=
XAI_API_KEY=
XAI_MODEL=
XAI_MODELS=
AI_AUTO_FALLBACK=true
AI_FALLBACK_ORDER=openai,grok,gemini
AI_DAILY_LIMIT=20
