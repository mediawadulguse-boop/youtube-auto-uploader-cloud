# PRIVATE ORACLE VM ONLY. Never commit the actual .env.
APP_DOMAIN=your-app.example.org
APP_URL=https://your-app.example.org
APP_SECRET=KEEP_ORIGINAL_RAILWAY_APP_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

POSTGRES_DB=youtubehub
POSTGRES_USER=youtubehub
# Use a long random hex password, avoiding characters that require URL encoding.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_PASSWORD
DATABASE_VOLUME_MB=30720
GOOGLE_CLIENT_ID=YOUR_EXISTING_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_EXISTING_GOOGLE_OAUTH_CLIENT_SECRET
DATA_DIR=/data
WORKER_ENABLED=false
WORKER_INTERVAL_MS=5000
YOUTUBE_CHUNK_MB=8
AI_PROVIDER=groq
AI_AUTO_FALLBACK=true
AI_FALLBACK_ORDER=openai,groq,gemini
AI_DAILY_LIMIT=50
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
